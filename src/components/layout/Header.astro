---
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useAstroI18n } from '@/i18n';

const currentPath = Astro.url.pathname;
const { i18n } = useAstroI18n(Astro.url);
const email = i18n.t('common.email');
const emailShort = i18n.t('common.emailShort');
---

<header class="header" id="main-header">
  <div class="container">
    <div class="nav-container">
      <div class="profile-section">
        <img src="/images/profile-64.jpeg" alt="Damian Meroni" class="profile-image" />
        <span class="email full" data-i18n="common.email">{email}</span>
        <span class="email short" data-i18n="common.emailShort">{emailShort}</span>
      </div>

      <div class="nav-section">
        <Navigation currentPath={currentPath} />
        <MobileMenu currentPath={currentPath} />
        <LanguageSwitcher />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .header.hidden {
    transform: translateX(-50%) translateY(-120%);
  }

  .header.scrolled .nav-container {
    border-bottom: 1px solid var(--color-border);
  }

  .nav-container {
    background: var(--color-bg);
    border: none;
    border-radius: 999px;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    box-shadow: var(--shadow-md);
    transition: border-bottom var(--duration-normal) var(--ease-out);
  }

  .profile-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .profile-image {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .email {
    font-size: 0.8125rem;
    font-weight: 300;
    color: var(--color-text-secondary);
    transition: color var(--duration-normal) var(--ease-out);
  }

  .email.short {
    display: none;
  }

  .nav-section {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 1024px) and (min-width: 640px) {
    .nav-container {
      padding: 0.6rem 1.25rem;
      gap: 1.5rem;
    }

    .profile-image {
      width: 26px;
      height: 26px;
    }

    .email {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 639px) {
    .email.full {
      display: none;
    }

    .email.short {
      display: block;
    }

    .header {
      top: 0.5rem;
      left: 0.5rem;
      right: 0.5rem;
      transform: none;
      width: auto;
    }

    .header.hidden {
      transform: translateY(-120%);
    }

    .nav-container {
      padding: 0.75rem 1rem;
      gap: 1rem;
      justify-content: space-between;
      min-height: 52px;
      align-items: center;
    }

    .profile-section {
      gap: 0.75rem;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .profile-image {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
    }

    .email {
      font-size: 0.875rem;
      white-space: nowrap;
      font-weight: 300;
      line-height: 1;
    }

    .nav-section {
      gap: 0.75rem;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .nav-container {
      padding: 0 0.75rem;
      gap: 0.75rem;
      min-height: 48px;
    }

    .profile-section {
      gap: 0.625rem;
    }

    .profile-image {
      width: 28px;
      height: 28px;
    }

    .email {
      font-size: 0.8125rem;
    }

    .nav-section {
      gap: 0.625rem;
    }
  }

  @media (max-width: 400px) {
    .email.short {
      display: none;
    }

    .nav-container {
      padding: 0.625rem 0.75rem;
      min-height: 44px;
    }

    .profile-image {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  let lastScrollY = 0;
  let ticking = false;

  const header = document.getElementById('main-header');

  function updateHeader() {
    const scrollY = window.scrollY;

    if (scrollY > lastScrollY && scrollY > 100) {
      header?.classList.add('hidden');
    } else {
      header?.classList.remove('hidden');
    }

    if (scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }

    lastScrollY = scrollY;
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }

  window.addEventListener('scroll', requestTick, { passive: true });
</script>
