---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;

const classes = `
  card
  ${className}
`;
---

<div class={classes}>
  <slot />
</div>

<style>
  .card {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
    position: relative;
    overflow: hidden;
  }
</style>
