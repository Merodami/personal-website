---
interface Props {
  id?: string;
  class?: string;
  gradient?: boolean;
}

const { id, class: className = '', gradient = false } = Astro.props;
---

<section id={id} class={`section ${className}`}>
  <div class="container mx-auto px-4 relative z-10">
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: 4rem 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: 8rem 0;
    }
  }
</style>
