---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;
---

<section id={id} class={`section ${className}`}>
  <div class="container mx-auto px-4 relative z-10">
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    padding: 3rem 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: 5rem 0;
    }
  }
</style>
