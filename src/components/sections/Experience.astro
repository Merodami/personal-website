---
import Section from '@components/common/Section.astro';
import Badge from '@components/common/Badge.astro';
import { useAstroI18n } from '@/i18n';

interface Experience {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  description: string;
  technologies: string[];
}

const { i18n } = useAstroI18n(Astro.url);
const experiences = i18n.t<Experience[]>('experience.jobs');
---

<Section id="experience">
  <div class="experience-layout">
    <div>
      <h2 class="experience-title" data-i18n="experience.title">
        {i18n.t('experience.title')}
      </h2>
      <p class="experience-subtitle" data-i18n="about.paragraph1">
        {i18n.t('about.paragraph1')}
      </p>
    </div>

    <div class="experience-list" data-i18n-experience-cards>
      {
        experiences.map((exp) => (
          <div class="experience-card">
            <div class="experience-card-inner">
              <div class="experience-dot" />
              <div class="experience-content">
                <div class="experience-header">
                  <h3 class="experience-company">{exp.company}</h3>
                  <div class="experience-position">{exp.position}</div>
                </div>

                <div class="experience-date">
                  {exp.startDate} - {exp.endDate}
                </div>

                <p class="experience-description">{exp.description}</p>

                <div class="experience-tech">
                  {exp.technologies.map((tech: string) => (
                    <Badge text={tech} variant="primary" />
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .experience-layout {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .experience-layout {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  .experience-title {
    font-size: clamp(1.875rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .experience-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .experience-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  .experience-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-lg);
  }

  .experience-card-inner {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .experience-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 8px var(--glow-primary);
    margin-top: 0.625rem;
  }

  .experience-content {
    flex-grow: 1;
  }

  .experience-header {
    margin-bottom: 0.5rem;
  }

  .experience-company {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .experience-position {
    font-size: 1.125rem;
    color: var(--color-primary);
  }

  .experience-date {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .experience-description {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .experience-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
