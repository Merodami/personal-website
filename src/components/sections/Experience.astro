---
import Section from '@components/common/Section.astro';
import Badge from '@components/common/Badge.astro';
import { useAstroI18n } from '@/i18n';

interface Experience {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  description: string;
  technologies: string[];
}

const { i18n } = useAstroI18n(Astro.url);
const experiences = i18n.t<Experience[]>('experience.jobs');
---

<Section id="experience">
  <div class="experience-container">
    <h2 class="experience-title animate-on-scroll" data-i18n="experience.title">
      {i18n.t('experience.title')}
    </h2>

    <div class="experience-list" data-i18n-experience-cards>
      {
        experiences.map((exp, index) => (
          <div class={`experience-entry animate-on-scroll animation-delay-${(index + 1) * 100}`}>
            <h3 class="experience-company">{exp.company}</h3>
            <div class="experience-position">{exp.position}</div>
            <div class="experience-dates">
              {exp.startDate} - {exp.endDate}
            </div>
            <p class="experience-description">{exp.description}</p>
            <div class="experience-tech">
              {exp.technologies.map((tech: string) => (
                <Badge text={tech} variant="primary" />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .experience-container {
    max-width: 720px;
    margin: 0 auto;
  }

  .experience-title {
    font-weight: 400;
    font-size: var(--text-h2);
    margin-bottom: 2.5rem;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
  }

  .experience-entry {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .experience-entry:first-child {
    padding-top: 0;
  }

  .experience-entry:last-child {
    border-bottom: none;
  }

  .experience-company {
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--color-text);
    margin: 0 0 0.25rem;
  }

  .experience-position {
    font-weight: 300;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin-bottom: 0.25rem;
  }

  .experience-dates {
    font-weight: 300;
    color: var(--color-text-tertiary);
    font-size: 0.8125rem;
    margin-bottom: 0.75rem;
  }

  .experience-description {
    font-weight: 300;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .experience-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
