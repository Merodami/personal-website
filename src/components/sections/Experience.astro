---
import Section from '@components/common/Section.astro';
import Badge from '@components/common/Badge.astro';
import { useAstroI18n } from '@/i18n';

interface Experience {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  description: string;
  technologies: string[];
}

const { i18n } = useAstroI18n(Astro.url);
const experiences = i18n.t<Experience[]>('experience.jobs');
---

<Section id="experience">
  <div class="experience-container">
    <h2 class="experience-title" data-i18n="experience.title">
      {i18n.t('experience.title')}
    </h2>

    <div class="experience-list" data-i18n-experience-cards>
      {
        experiences.map((exp, index) => (
          <>
            {index > 0 && <hr class="hairline-rule" />}
            <article class="experience-item">
              <div class="experience-dates">
                {exp.startDate} - {exp.endDate}
              </div>
              <h3 class="experience-company">{exp.company}</h3>
              <div class="experience-position">{exp.position}</div>
              <p class="experience-description">{exp.description}</p>
              <div class="experience-tech">
                {exp.technologies.map((tech: string, techIndex: number) => (
                  <span>
                    {tech}
                    {techIndex < exp.technologies.length - 1 ? ', ' : ''}
                  </span>
                ))}
              </div>
            </article>
          </>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .experience-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .experience-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 4vw, 2.5rem);
    color: var(--color-text);
    margin-bottom: 3rem;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
  }

  .hairline-rule {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  .experience-item {
    padding: 2.5rem 0;
  }

  .experience-dates {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .experience-company {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .experience-position {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .experience-description {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .experience-tech {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    line-height: 1.6;
  }
</style>
