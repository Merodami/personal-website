---
import Section from '@components/common/Section.astro';
import Card from '@components/common/Card.astro';
import Badge from '@components/common/Badge.astro';
import { useAstroI18n } from '@/i18n';

interface Experience {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  description: string;
  technologies: string[];
}

const { i18n } = useAstroI18n(Astro.url);
const experiences = i18n.t<Experience[]>('experience.jobs');

const neoColors = [
  'var(--neo-yellow)',
  'var(--neo-pink)',
  'var(--neo-lime)',
  'var(--neo-blue)',
  'var(--neo-orange)',
  'var(--neo-purple)',
];
---

<Section id="experience">
  <div class="experience-wrapper">
    <h2 class="experience-title" data-i18n="experience.title">
      {i18n.t('experience.title')}
    </h2>
    <p class="experience-description" data-i18n="about.paragraph1">
      {i18n.t('about.paragraph1')}
    </p>

    <div class="experience-cards" data-i18n-experience-cards>
      {
        experiences.map((exp, index) => (
          <Card hover={false} class="relative">
            <div class="card-inner">
              <div class="card-indicator" />
              <div class="card-content">
                <div class="card-header">
                  <h3 class="company-name" style={`color: ${neoColors[index % neoColors.length]}`}>
                    {exp.company}
                  </h3>
                  <div class="position-name">{exp.position}</div>
                </div>

                <div class="date-range">
                  {exp.startDate} - {exp.endDate}
                </div>

                <p class="card-description">{exp.description}</p>

                <div class="tech-badges">
                  {exp.technologies.map((tech: string) => (
                    <Badge text={tech} variant="primary" />
                  ))}
                </div>
              </div>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .experience-wrapper {
    max-width: 48rem;
    margin: 0 auto;
  }

  .experience-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 700;
    text-transform: uppercase;
    border-bottom: 4px solid var(--neo-pink);
    display: inline-block;
    padding-bottom: 0.25rem;
    margin-bottom: 1rem;
  }

  .experience-description {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .experience-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card-inner {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .card-indicator {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 0;
    margin-top: 0.5rem;
    background-color: var(--color-primary);
  }

  .card-content {
    flex-grow: 1;
  }

  .card-header {
    margin-bottom: 0.5rem;
  }

  .company-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0;
  }

  .position-name {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-primary);
  }

  .date-range {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .card-description {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
