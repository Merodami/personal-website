---
import Section from '@components/common/Section.astro';
import Badge from '@components/common/Badge.astro';
import { useAstroI18n } from '@/i18n';

interface Experience {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  description: string;
  technologies: string[];
}

const { i18n } = useAstroI18n(Astro.url);
const experiences = i18n.t<Experience[]>('experience.jobs');
---

<Section id="experience">
  <div class="experience-layout">
    <h2 class="experience-title" data-i18n="experience.title">
      {i18n.t('experience.title')}
    </h2>
    <p class="experience-subtitle" data-i18n="about.paragraph1">
      {i18n.t('about.paragraph1')}
    </p>

    <div class="experience-list" data-i18n-experience-cards>
      {
        experiences.map((exp) => (
          <div class="experience-card bento-cell">
            <div class="experience-card-inner">
              <div class="dot-indicator" />
              <div class="experience-content">
                <div class="experience-header">
                  <h3 class="company-name">{exp.company}</h3>
                  <div class="position-name">{exp.position}</div>
                </div>

                <div class="experience-dates">
                  {exp.startDate} - {exp.endDate}
                </div>

                <p class="experience-description">{exp.description}</p>

                <div class="flex flex-wrap gap-2">
                  {exp.technologies.map((tech: string) => (
                    <Badge text={tech} variant="primary" />
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .experience-layout {
    max-width: 720px;
    margin: 0 auto;
  }

  .experience-title {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .experience-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .experience-card {
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    background: var(--color-surface);
    transition: all 0.3s ease;
  }

  .experience-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-hover);
  }

  .experience-card-inner {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .dot-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    margin-top: 0.5rem;
    flex-shrink: 0;
  }

  .experience-content {
    flex: 1;
    min-width: 0;
  }

  .experience-header {
    margin-bottom: 0.5rem;
  }

  .company-name {
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 0.125rem;
  }

  .position-name {
    font-weight: 400;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  .experience-dates {
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
    margin-bottom: 0.75rem;
  }

  .experience-description {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
</style>
