---
import Button from '@components/common/Button.astro';
import DynamicText from '@components/ui/DynamicText.astro';
import { FEATURE_FLAGS } from '@config/constants';
import { useAstroI18n, getLocalizedUrl } from '@/i18n';

const { lang, i18n } = useAstroI18n(Astro.url);
const cvPath =
  lang === 'es'
    ? '/cv/international/Damian_Meroni_CV_ES_I.pdf'
    : '/cv/international/Damian_Meroni_CV_EN_I.pdf';

const dynamicWords = [
  { text: i18n.t('hero.dynamicWords.build'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.create'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.develop'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.engineer'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.craft'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.architect'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.code'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.forge'), color: 'var(--color-text-secondary)' },
  { text: i18n.t('hero.dynamicWords.shape'), color: 'var(--color-text-secondary)' },
];
---

<section class="hero-section">
  <div class="container">
    <div class="hero-content animate-on-scroll">
      <h1 class="hero-title">
        <span data-i18n="hero.title.part1">{i18n.t('hero.title.part1')}</span>
        <span class="desktop-space"> </span>
        <br class="mobile-break" />
        <DynamicText words={dynamicWords} className="data-i18n-dynamic-words" /><br />
        <span class="accent-text" data-i18n="hero.title.part2">{i18n.t('hero.title.part2')}</span>
        <span data-i18n="hero.title.part3">{i18n.t('hero.title.part3')}</span>
      </h1>

      <p
        class="hero-description animate-on-scroll animation-delay-200"
        data-i18n="hero.description"
      >
        {i18n.t('hero.description')}
      </p>

      <div class="hero-actions animate-on-scroll animation-delay-400">
        {
          FEATURE_FLAGS.showProjects && (
            <Button href={getLocalizedUrl('/projects', lang)} size="lg">
              <span data-i18n="common.viewMyWork">{i18n.t('common.viewMyWork')}</span>
            </Button>
          )
        }
        <Button href={getLocalizedUrl('/contact', lang)} variant="outline" size="lg">
          <span data-i18n="common.getInTouch">{i18n.t('common.getInTouch')}</span>
        </Button>
        <div class="button-group">
          <a href={cvPath} download class="cv-download-button" data-cv-download>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="cv-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            <span data-i18n="experience.downloadCV">{i18n.t('experience.downloadCV')}</span>
          </a>
          <a
            href="https://github.com/Merodami"
            target="_blank"
            rel="noopener noreferrer"
            class="github-button"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="github-icon"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--color-bg);
    padding: 2rem 0;
  }

  .hero-content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .accent-text {
    color: var(--color-text);
  }

  .hero-description {
    font-size: 1rem;
    font-weight: 300;
    color: var(--color-text-secondary);
    text-align: center;
    max-width: 480px;
    margin: 1.5rem auto 0;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .button-group {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    width: 100%;
  }

  .cv-download-button,
  .github-button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
    white-space: nowrap;
  }

  .cv-download-button:hover,
  .github-button:hover {
    color: var(--color-text);
  }

  .cv-icon,
  .github-icon {
    width: 1rem;
    height: 1rem;
  }

  .mobile-break {
    display: none;
  }

  .desktop-space {
    display: inline;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 6rem 1rem 2rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions > :global(*) {
      width: 100%;
    }

    .button-group {
      flex-direction: row;
      justify-content: center;
      gap: 1.5rem;
    }

    .mobile-break {
      display: block;
    }

    .desktop-space {
      display: none;
    }
  }
</style>
