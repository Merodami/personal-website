---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
---

<Section id="about">
  <div class="about-container">
    <h2 class="about-title animate-on-scroll" data-i18n="about.title">
      {i18n.t('about.title')}
    </h2>

    <div class="about-paragraphs animate-on-scroll animation-delay-100">
      <p data-i18n="about.paragraph1">{i18n.t('about.paragraph1')}</p>
      <p data-i18n="about.paragraph2">{i18n.t('about.paragraph2')}</p>
    </div>

    <div class="stats-grid animate-on-scroll animation-delay-200">
      <div class="stat-item">
        <div class="stat-number" data-i18n="about.stats.experience">
          {i18n.t('about.stats.experience')}
        </div>
        <div class="stat-label" data-i18n="about.stats.experienceLabel">
          {i18n.t('about.stats.experienceLabel')}
        </div>
      </div>
      <div class="stat-item stat-divider">
        <div class="stat-number" data-i18n="about.stats.fullStack">
          {i18n.t('about.stats.fullStack')}
        </div>
        <div class="stat-label" data-i18n="about.stats.fullStackLabel">
          {i18n.t('about.stats.fullStackLabel')}
        </div>
      </div>
      <div class="stat-item stat-divider">
        <div class="stat-number" data-i18n="about.stats.cloud">
          {i18n.t('about.stats.cloud')}
        </div>
        <div class="stat-label" data-i18n="about.stats.cloudLabel">
          {i18n.t('about.stats.cloudLabel')}
        </div>
      </div>
      <div class="stat-item stat-divider">
        <div class="stat-number" data-i18n="about.stats.remote">
          {i18n.t('about.stats.remote')}
        </div>
        <div class="stat-label" data-i18n="about.stats.remoteLabel">
          {i18n.t('about.stats.remoteLabel')}
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .about-container {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .about-title {
    font-weight: 400;
    font-size: var(--text-h2);
    margin-bottom: 1.5rem;
  }

  .about-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-paragraphs p {
    font-weight: 300;
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto;
    color: var(--color-text-secondary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .stat-item {
    text-align: center;
  }

  .stat-divider {
    border-left: 1px solid var(--color-border);
  }

  .stat-number {
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--color-text);
  }

  .stat-label {
    font-weight: 300;
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-divider {
      border-left: none;
    }

    .stat-divider:nth-child(odd) {
      border-left: none;
    }

    .stat-divider:nth-child(even) {
      border-left: 1px solid var(--color-border);
    }
  }
</style>
