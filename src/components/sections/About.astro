---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
---

<Section id="about">
  <div class="about-container">
    <h2 class="about-title" data-i18n="about.title">
      {i18n.t('about.title')}
    </h2>

    <div class="about-text">
      <p data-i18n="about.paragraph1">{i18n.t('about.paragraph1')}</p>
      <p data-i18n="about.paragraph2">{i18n.t('about.paragraph2')}</p>
    </div>

    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-number" data-i18n="about.stats.experience">
          {i18n.t('about.stats.experience')}
        </div>
        <div class="stat-label" data-i18n="about.stats.experienceLabel">
          {i18n.t('about.stats.experienceLabel')}
        </div>
      </div>
      <div class="stat-item stat-border">
        <div class="stat-number" data-i18n="about.stats.fullStack">
          {i18n.t('about.stats.fullStack')}
        </div>
        <div class="stat-label" data-i18n="about.stats.fullStackLabel">
          {i18n.t('about.stats.fullStackLabel')}
        </div>
      </div>
      <div class="stat-item stat-border">
        <div class="stat-number" data-i18n="about.stats.cloud">
          {i18n.t('about.stats.cloud')}
        </div>
        <div class="stat-label" data-i18n="about.stats.cloudLabel">
          {i18n.t('about.stats.cloudLabel')}
        </div>
      </div>
      <div class="stat-item">
        <div class="stat-number" data-i18n="about.stats.remote">
          {i18n.t('about.stats.remote')}
        </div>
        <div class="stat-label" data-i18n="about.stats.remoteLabel">
          {i18n.t('about.stats.remoteLabel')}
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .about-container {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .about-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 4vw, 2.5rem);
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  .about-text {
    max-width: 600px;
    margin: 0 auto;
  }

  .about-text p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 4rem;
  }

  .stat-item {
    text-align: center;
    padding: 1rem 0;
  }

  .stat-border {
    border-right: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .stat-number {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: 2rem;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 0;
    }

    .stat-border {
      border-left: none;
    }

    .stat-border:nth-child(2) {
      border-right: none;
      border-left: 1px solid var(--color-border);
    }

    .stat-border:nth-child(3) {
      border-right: 1px solid var(--color-border);
      border-left: none;
    }
  }
</style>
