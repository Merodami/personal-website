---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
---

<Section id="about">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="about-title animate-on-scroll" data-i18n="about.title">
      {i18n.t('about.title')}
    </h2>

    <div class="about-text animate-on-scroll animation-delay-100">
      <p data-i18n="about.paragraph1">{i18n.t('about.paragraph1')}</p>
      <p data-i18n="about.paragraph2">{i18n.t('about.paragraph2')}</p>
    </div>

    <div class="stats-grid bento-grid animate-on-scroll animation-delay-200">
      <div class="stat-cell bento-cell">
        <div class="stat-number" data-i18n="about.stats.experience">
          {i18n.t('about.stats.experience')}
        </div>
        <div class="stat-label" data-i18n="about.stats.experienceLabel">
          {i18n.t('about.stats.experienceLabel')}
        </div>
      </div>
      <div class="stat-cell bento-cell">
        <div class="stat-number" data-i18n="about.stats.fullStack">
          {i18n.t('about.stats.fullStack')}
        </div>
        <div class="stat-label" data-i18n="about.stats.fullStackLabel">
          {i18n.t('about.stats.fullStackLabel')}
        </div>
      </div>
      <div class="stat-cell bento-cell">
        <div class="stat-number" data-i18n="about.stats.cloud">
          {i18n.t('about.stats.cloud')}
        </div>
        <div class="stat-label" data-i18n="about.stats.cloudLabel">
          {i18n.t('about.stats.cloudLabel')}
        </div>
      </div>
      <div class="stat-cell bento-cell">
        <div class="stat-number" data-i18n="about.stats.remote">
          {i18n.t('about.stats.remote')}
        </div>
        <div class="stat-label" data-i18n="about.stats.remoteLabel">
          {i18n.t('about.stats.remoteLabel')}
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .about-title {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 3rem;
  }

  .stat-cell {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .stat-cell:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .stat-number {
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }

  @media (max-width: 767px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
