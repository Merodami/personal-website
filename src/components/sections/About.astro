---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
---

<Section id="about">
  <div class="about-wrapper">
    <h2 class="about-title animate-on-scroll" data-i18n="about.title">
      {i18n.t('about.title')}
    </h2>

    <div class="about-text animate-on-scroll animation-delay-100">
      <p data-i18n="about.paragraph1">{i18n.t('about.paragraph1')}</p>
      <p data-i18n="about.paragraph2">{i18n.t('about.paragraph2')}</p>
    </div>

    <div class="stats-grid animate-on-scroll animation-delay-200">
      <div class="stat-card">
        <div class="stat-number" data-i18n="about.stats.experience">
          {i18n.t('about.stats.experience')}
        </div>
        <div class="stat-label" data-i18n="about.stats.experienceLabel">
          {i18n.t('about.stats.experienceLabel')}
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-number" data-i18n="about.stats.fullStack">
          {i18n.t('about.stats.fullStack')}
        </div>
        <div class="stat-label" data-i18n="about.stats.fullStackLabel">
          {i18n.t('about.stats.fullStackLabel')}
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-number" data-i18n="about.stats.cloud">
          {i18n.t('about.stats.cloud')}
        </div>
        <div class="stat-label" data-i18n="about.stats.cloudLabel">
          {i18n.t('about.stats.cloudLabel')}
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-number" data-i18n="about.stats.remote">
          {i18n.t('about.stats.remote')}
        </div>
        <div class="stat-label" data-i18n="about.stats.remoteLabel">
          {i18n.t('about.stats.remoteLabel')}
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .about-wrapper {
    max-width: 48rem;
    margin: 0 auto;
    text-align: center;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 700;
    text-transform: uppercase;
    border-bottom: 4px solid var(--neo-pink);
    display: inline-block;
    padding-bottom: 0.25rem;
    margin-bottom: 1.5rem;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .stats-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    border: 3px solid var(--color-border);
    padding: 1.25rem;
    box-shadow: var(--shadow-hard-md);
    text-align: center;
  }

  .stat-card:nth-child(1) {
    background: var(--neo-yellow);
  }

  .stat-card:nth-child(2) {
    background: var(--neo-pink);
  }

  .stat-card:nth-child(3) {
    background: var(--neo-lime);
  }

  .stat-card:nth-child(4) {
    background: var(--neo-blue);
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: #000;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: #000;
    margin-top: 0.25rem;
  }
</style>
