---
import Section from '@components/common/Section.astro';
import ProjectCard from '@components/cards/ProjectCard.astro';
import { projects } from '@data/projects';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
const featuredProjects = projects.filter((p) => p.featured);
---

<Section id="projects">
  <div class="projects-header">
    <h2 class="projects-title">{i18n.t('projects.title')}</h2>
    <p class="projects-subtitle">
      {i18n.t('about.paragraph2')}
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      featuredProjects.map((project) => (
        <div>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>

  <div class="projects-footer">
    <a href="/projects" class="view-all-link">
      View All Projects
      <svg class="view-all-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </a>
  </div>
</Section>

<style>
  .projects-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .projects-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2rem, 4vw, 2.5rem);
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .projects-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 32rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  .projects-footer {
    text-align: center;
    margin-top: 3rem;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-all-link:hover {
    color: var(--color-text);
  }

  .view-all-arrow {
    width: 1rem;
    height: 1rem;
  }
</style>
