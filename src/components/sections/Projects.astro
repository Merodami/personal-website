---
import Section from '@components/common/Section.astro';
import ProjectCard from '@components/cards/ProjectCard.astro';
import { projects } from '@data/projects';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
const featuredProjects = projects.filter((p) => p.featured);
---

<Section id="projects">
  <div class="projects-header animate-on-scroll">
    <h2 class="projects-title">{i18n.t('projects.title')}</h2>
    <p class="projects-subtitle">
      {i18n.t('about.paragraph2')}
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      featuredProjects.map((project, index) => (
        <div class="animate-on-scroll" style={`animation-delay: ${index * 100}ms`}>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>

  <div class="projects-footer animate-on-scroll">
    <a href="/projects" class="view-all-link">
      <span>View All Projects</span>
      <svg class="view-all-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </a>
  </div>
</Section>

<style>
  .projects-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .projects-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .projects-subtitle {
    font-size: 1.125rem;
    max-width: 42rem;
    margin: 0 auto;
    color: var(--color-text-secondary);
  }

  .projects-footer {
    text-align: center;
    margin-top: 3rem;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-accent);
    font-family: var(--font-mono);
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    font-weight: 600;
    gap: 0.5rem;
  }

  .view-all-link:hover .view-all-arrow {
    transform: translateX(4px);
  }

  .view-all-arrow {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease;
  }
</style>
