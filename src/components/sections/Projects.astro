---
import Section from '@components/common/Section.astro';
import ProjectCard from '@components/cards/ProjectCard.astro';
import { projects } from '@data/projects';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
const featuredProjects = projects.filter((p) => p.featured);
---

<Section id="projects">
  <div class="text-center mb-12 animate-on-scroll">
    <h2 class="projects-title">{i18n.t('projects.title')}</h2>
    <p class="projects-subtitle">
      {i18n.t('about.paragraph2')}
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      featuredProjects.map((project, index) => (
        <div class="animate-on-scroll" style={`animation-delay: ${index * 100}ms`}>
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>

  <div class="text-center mt-12 animate-on-scroll">
    <a href="/projects" class="view-all-link animated-link">
      <span>View All Projects</span>
      <svg class="view-all-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </a>
  </div>
</Section>

<style>
  .projects-title {
    font-weight: 400;
    font-size: var(--text-h2);
    margin-bottom: 1rem;
  }

  .projects-subtitle {
    font-size: 1rem;
    max-width: 32rem;
    margin: 0 auto;
    color: var(--color-text-secondary);
    font-weight: 300;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 400;
    text-decoration: none;
  }

  .view-all-arrow {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration-fast) ease;
  }

  .view-all-link:hover .view-all-arrow {
    transform: translateX(2px);
  }
</style>
