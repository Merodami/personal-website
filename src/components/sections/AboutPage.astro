---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
const skills = i18n.t<string[]>('aboutPage.skills');
---

<Section class="mt-4 sm:mt-0">
  <div class="max-w-3xl mx-auto">
    <h1 class="page-title" data-i18n="aboutPage.title">
      {i18n.t('aboutPage.title')}
    </h1>

    <div class="prose-content">
      <p data-i18n="aboutPage.intro1">
        {i18n.t('aboutPage.intro1')}
      </p>

      <p data-i18n="aboutPage.intro2">
        {i18n.t('aboutPage.intro2')}
      </p>

      <p data-i18n="aboutPage.intro3">
        {i18n.t('aboutPage.intro3')}
      </p>

      <h2 class="skills-title" data-i18n="aboutPage.technicalSkillsTitle">
        {i18n.t('aboutPage.technicalSkillsTitle')}
      </h2>

      <div class="skills-grid bento-grid" data-i18n-skills>
        {skills.map((skill) => <div class="skill-cell bento-cell">{skill}</div>)}
      </div>
    </div>
  </div>
</Section>

<style>
  .page-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 2rem;
    text-align: center;
  }

  .prose-content {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .prose-content p {
    margin-bottom: 1.25rem;
  }

  .skills-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }

  .skill-cell {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-align: center;
    transition: all 0.2s ease;
  }

  .skill-cell:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
