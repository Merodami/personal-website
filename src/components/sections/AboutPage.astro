---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
const skills = i18n.t<string[]>('aboutPage.skills');
---

<Section class="mt-4 sm:mt-0">
  <div class="max-w-3xl mx-auto">
    <h1 class="about-page-title" data-i18n="aboutPage.title">
      {i18n.t('aboutPage.title')}
    </h1>

    <div class="about-page-prose">
      <p data-i18n="aboutPage.intro1">
        {i18n.t('aboutPage.intro1')}
      </p>

      <p data-i18n="aboutPage.intro2">
        {i18n.t('aboutPage.intro2')}
      </p>

      <p data-i18n="aboutPage.intro3">
        {i18n.t('aboutPage.intro3')}
      </p>

      <h2 class="skills-title" data-i18n="aboutPage.technicalSkillsTitle">
        {i18n.t('aboutPage.technicalSkillsTitle')}
      </h2>

      <div class="skills-grid" data-i18n-skills>
        {skills.map((skill) => <div class="skill-panel">{skill}</div>)}
      </div>
    </div>
  </div>
</Section>

<style>
  .about-page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 2rem;
    text-align: center;
  }

  .about-page-prose {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .about-page-prose p {
    margin-bottom: 1.5rem;
  }

  .skills-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-panel {
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    text-align: center;
    color: var(--color-text-secondary);
    transition: all 0.3s ease;
  }

  .skill-panel:hover {
    border-color: var(--color-primary);
    box-shadow: 0 0 12px var(--glow-primary);
  }
</style>
