---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
const skills = i18n.t<string[]>('aboutPage.skills');
---

<Section class="mt-4 sm:mt-0">
  <div class="about-page-container">
    <h1 class="about-page-title" data-i18n="aboutPage.title">
      {i18n.t('aboutPage.title')}
    </h1>

    <div class="about-page-prose">
      <p class="drop-cap" data-i18n="aboutPage.intro1">
        {i18n.t('aboutPage.intro1')}
      </p>

      <p data-i18n="aboutPage.intro2">
        {i18n.t('aboutPage.intro2')}
      </p>

      <p data-i18n="aboutPage.intro3">
        {i18n.t('aboutPage.intro3')}
      </p>

      <h2 class="skills-heading" data-i18n="aboutPage.technicalSkillsTitle">
        {i18n.t('aboutPage.technicalSkillsTitle')}
      </h2>

      <div class="skills-grid" data-i18n-skills>
        {skills.map((skill) => <div class="skill-item">{skill}</div>)}
      </div>
    </div>
  </div>
</Section>

<style>
  .about-page-container {
    max-width: 48rem;
    margin: 0 auto;
  }

  .about-page-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--color-text);
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .about-page-prose {
    max-width: 600px;
    margin: 0 auto;
  }

  .about-page-prose p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .drop-cap::first-letter {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 3.5rem;
    float: left;
    line-height: 0.8;
    padding-right: 0.5rem;
    padding-top: 0.25rem;
    color: var(--color-text);
    font-weight: 400;
  }

  .skills-heading {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-weight: 400;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--color-text);
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-item {
    border: 1px solid var(--color-border);
    border-radius: 0;
    padding: 0.5rem 1rem;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    text-align: center;
    transition: border-color 0.2s ease;
  }

  .skill-item:hover {
    border-color: var(--color-text);
  }
</style>
