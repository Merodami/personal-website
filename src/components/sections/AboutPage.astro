---
import Section from '@components/common/Section.astro';
import { useAstroI18n } from '@/i18n';

const { i18n } = useAstroI18n(Astro.url);
const skills = i18n.t<string[]>('aboutPage.skills');
---

<Section class="mt-4 sm:mt-0">
  <div class="about-page-wrapper">
    <h1 class="about-page-title" data-i18n="aboutPage.title">
      {i18n.t('aboutPage.title')}
    </h1>

    <div class="about-page-prose">
      <p data-i18n="aboutPage.intro1">
        {i18n.t('aboutPage.intro1')}
      </p>

      <p data-i18n="aboutPage.intro2">
        {i18n.t('aboutPage.intro2')}
      </p>

      <p data-i18n="aboutPage.intro3">
        {i18n.t('aboutPage.intro3')}
      </p>

      <h2 class="skills-heading" data-i18n="aboutPage.technicalSkillsTitle">
        {i18n.t('aboutPage.technicalSkillsTitle')}
      </h2>

      <div class="skills-grid" data-i18n-skills>
        {skills.map((skill) => <div class="skill-item">{skill}</div>)}
      </div>
    </div>
  </div>
</Section>

<style>
  .about-page-wrapper {
    max-width: 48rem;
    margin: 0 auto;
  }

  .about-page-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    border-bottom: 4px solid var(--neo-pink);
    display: inline-block;
    padding-bottom: 0.25rem;
    margin-bottom: 2rem;
    text-align: center;
    width: 100%;
  }

  .about-page-prose {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .about-page-prose p {
    margin-bottom: 1.25rem;
  }

  .skills-heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-item {
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-hard-sm);
    font-family: var(--font-mono);
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    font-weight: 600;
    font-size: 0.875rem;
    color: #000;
    text-align: center;
    transform: rotate(var(--rotation, 0deg));
  }

  .skill-item:nth-child(6n + 1) {
    background: var(--neo-yellow);
    --rotation: -1.5deg;
  }

  .skill-item:nth-child(6n + 2) {
    background: var(--neo-pink);
    --rotation: 1deg;
  }

  .skill-item:nth-child(6n + 3) {
    background: var(--neo-lime);
    --rotation: -0.5deg;
  }

  .skill-item:nth-child(6n + 4) {
    background: var(--neo-blue);
    --rotation: 2deg;
  }

  .skill-item:nth-child(6n + 5) {
    background: var(--neo-orange);
    --rotation: -1deg;
  }

  .skill-item:nth-child(6n + 6) {
    background: var(--neo-purple);
    --rotation: 1.5deg;
  }
</style>
