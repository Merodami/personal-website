---
const criticalCSS = `
  /* Reset and base styles */
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }

  /* Layout essentials */
  .h-full { height: 100%; }
  .container { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 1rem; }

  /* Typography for hero */
  .hero-title { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; margin: 0; text-transform: uppercase; font-weight: 700; }

  /* Theme colors - aligned with themes.css variable names */
  [data-theme="dark"] {
    --color-bg: #1A1A1A;
    --color-text: #ffffff;
    --color-surface: #222222;
    --color-border: #ffffff;
  }
  [data-theme="light"] {
    --color-bg: #ffffff;
    --color-text: #000000;
    --color-surface: #FFFFFF;
    --color-border: #000000;
  }
  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
  }

  /* Navigation layout */
  header { position: sticky; top: 0; z-index: 50; }
  .nav-section { display: flex; align-items: center; gap: 1rem; }

  /* Hero section */
  .hero-section { min-height: 100vh; display: flex; align-items: center; }

  /* Common components */
  .email { display: inline-block; }
  .main-content { flex: 1; }

  /* Card styles - neobrutalism */
  .card { background: var(--color-surface); border: 2px solid var(--color-border); border-radius: 0px; box-shadow: 4px 4px 0px var(--color-border); }

  /* Grid layouts */
  .grid { display: grid; gap: 1rem; }
  @media (min-width: 768px) {
    .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
    .grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
  }
`;
---

<style is:inline set:html={criticalCSS}></style>
