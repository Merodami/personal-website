---
const criticalCSS = `
  /* Reset and base styles */
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }

  /* Layout essentials */
  .h-full { height: 100%; }
  .container { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 1rem; }

  /* Typography for hero */
  .hero-title { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.15; margin: 0; font-weight: 600; letter-spacing: -0.02em; }

  /* Theme colors - Liquid Glass */
  [data-theme="dark"] {
    --color-bg: #050508;
    --color-bg-secondary: #0A0A12;
    --color-bg-tertiary: #12121E;
    --color-surface: rgba(20, 20, 35, 0.6);
    --color-surface-hover: rgba(30, 30, 50, 0.7);
    --color-text: #EEEEF5;
    --color-text-secondary: #B0B0CC;
    --color-text-tertiary: #7A7A9A;
    --color-text-inverse: #050508;
    --color-border: rgba(255, 255, 255, 0.08);
    --color-border-hover: rgba(255, 255, 255, 0.15);
    --color-primary: #A78BFA;
    --color-primary-hover: #C4B5FD;
    --color-primary-light: rgba(167, 139, 250, 0.1);
    --color-primary-dark: #DDD6FE;
    --color-accent: #22D3EE;
    --color-accent-hover: #67E8F9;
    --glass-bg: rgba(15, 15, 30, 0.6);
    --glass-border: rgba(255, 255, 255, 0.08);
    --glass-blur: 20px;
    --glow-primary: rgba(167, 139, 250, 0.25);
    --glow-accent: rgba(34, 211, 238, 0.25);
  }
  [data-theme="light"] {
    --color-bg: #F0F0F5;
    --color-bg-secondary: #E8E8F0;
    --color-bg-tertiary: #DDDDE8;
    --color-surface: rgba(255, 255, 255, 0.7);
    --color-surface-hover: rgba(255, 255, 255, 0.85);
    --color-text: #1A1A2E;
    --color-text-secondary: #4A4A6A;
    --color-text-tertiary: #7A7A9A;
    --color-text-inverse: #FFFFFF;
    --color-border: rgba(255, 255, 255, 0.3);
    --color-border-hover: rgba(255, 255, 255, 0.5);
    --color-primary: #8B5CF6;
    --color-primary-hover: #7C3AED;
    --color-primary-light: rgba(139, 92, 246, 0.1);
    --color-primary-dark: #6D28D9;
    --color-accent: #06B6D4;
    --color-accent-hover: #0891B2;
    --glass-bg: rgba(255, 255, 255, 0.6);
    --glass-border: rgba(255, 255, 255, 0.3);
    --glass-blur: 16px;
    --glow-primary: rgba(139, 92, 246, 0.3);
    --glow-accent: rgba(6, 182, 212, 0.3);
  }
  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
  }

  /* Glass panel critical styles */
  .glass-panel {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: 16px;
  }

  /* Navigation layout */
  header { position: sticky; top: 0; z-index: 50; }
  .nav-section { display: flex; align-items: center; gap: 1rem; }

  /* Hero section */
  .hero-section { min-height: 100vh; display: flex; align-items: center; }

  /* Common components */
  .email { display: inline-block; }
  .main-content { flex: 1; }

  /* Grid layouts */
  .grid { display: grid; gap: 1rem; }
  @media (min-width: 768px) {
    .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
    .grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
  }
`;
---

<style is:inline set:html={criticalCSS}></style>
