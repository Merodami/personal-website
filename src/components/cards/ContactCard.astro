---
import Button from '@components/common/Button.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  link?: {
    href: string;
    text: string;
    external?: boolean;
  };
  button?: {
    href: string;
    text: string;
    external?: boolean;
  };
}

const { title, description, icon, link, button } = Astro.props;
---

<div class="contact-card group">
  <div class="card-content">
    <div class="card-upper">
      <div class="icon-container mb-6">
        <Fragment set:html={icon} />
      </div>

      <h3 class="contact-title" data-i18n-title>{title}</h3>
      <p class="contact-description" data-i18n-description>{description}</p>
    </div>

    <div class="card-action">
      {
        link && (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="cta-link group/link"
          >
            <span class="link-text" data-i18n-link-text>
              {link.text}
            </span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path
                d="M7 13L13 7M13 7H7M13 7V13"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )
      }

      {
        button && (
          <Button href={button.href} size="md" variant="primary" external={button.external}>
            <span data-i18n-button-text>{button.text}</span>
          </Button>
        )
      }
    </div>
  </div>
</div>

<style>
  .contact-card {
    position: relative;
    border: 3px solid var(--color-border);
    border-radius: 0;
    background: var(--color-surface);
    box-shadow: var(--shadow-hard-lg);
    padding: 0;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .contact-card:hover {
    box-shadow: var(--shadow-hard-xl);
    transform: translate(-2px, -2px);
  }

  .card-content {
    position: relative;
    padding: 2rem;
    height: 550px;
  }

  .card-upper {
    padding-bottom: 150px;
    word-wrap: break-word;
    overflow-wrap: break-word;
    line-height: 1.6;
  }

  .card-action {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    right: 2rem;
    height: 100px;
    display: flex;
    align-items: center;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .icon-container {
    width: 64px;
    height: 64px;
    border: 2px solid var(--color-border);
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
  }

  .icon-container :global(svg) {
    width: 2rem;
    height: 2rem;
    color: #000;
  }

  :global([data-theme='dark']) .icon-container :global(svg) {
    color: #fff;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .contact-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
    transition: color 0.15s ease;
  }

  .link-text {
    position: relative;
  }

  @media (max-width: 768px) {
    .card-content {
      padding: 1.5rem;
      height: 360px;
    }

    .card-upper {
      padding-bottom: 20px;
      text-align: center;
    }

    .card-action {
      bottom: 1.5rem;
      left: 1.5rem;
      right: 1.5rem;
      height: 70px;
      justify-content: center;
    }

    .icon-container {
      margin: 0 auto;
    }

    .card-action :global(.button-base) {
      width: 100%;
      text-align: center;
    }

    .cta-link {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      transition: none;
    }
  }
</style>
